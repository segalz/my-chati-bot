{"id": "hn14", "set": "holdout", "text": "Send the file to the printer.", "react": false}
{"id": "hn15", "set": "holdout", "text": "The recipe needs two cups of flour.", "react": false}
{"id": "hn16", "set": "holdout", "text": "I'll be working from home tomorrow.", "react": false}
