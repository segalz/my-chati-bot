<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Stage 9: only the cloud voice for Hebrew uses the network (owner decision 2026-10-23);
         the eyes and the eye model never do. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Stage 9: the phone's speech engine (Hebrew voice) must be visible to the app (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="Chati Eyes"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <!-- No configChanges: rotation must recreate the activity (Stage 4 lifecycle tests). -->
        <!-- singleTask: one eyes screen; launching again (adb, installer "Open") reuses it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
